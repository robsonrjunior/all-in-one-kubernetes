# ============================================
# All-in-One Kubernetes n8n - Configuration
# ============================================
# Copie este arquivo para .env e ajuste os valores
# Variáveis sensíveis DEVEM ser armazenadas em Kubernetes Secrets
# (veja kubernetes/base/secrets.yaml)

# ============================================
# Ambiente de Deploy
# ============================================
# Define qual overlay Kustomize será usado pelo comando `make deploy`.
# Controla automaticamente: overlay, resource limits (CPU/memória),
# TLS, domínios e número de réplicas.
# Valores: dev | homolog | prod
#   dev    -> Minikube local, domínios nip.io, TLS desabilitado, recursos reduzidos
#   homolog -> Cluster de homologação, domínio homolog.<DOMAIN>, cert-manager staging
#   prod   -> Cluster de produção, domínio <DOMAIN>, cert-manager production, HA
DEPLOY_ENV=dev

# ============================================
# Geral
# ============================================
NAMESPACE=all-in-one
# DOMAIN: domínio base altera por ambiente
#   dev    -> 127.0.0.1.nip.io (automático, não requer alteração)
#   homolog -> homolog.exemplo.com
#   prod   -> exemplo.com
DOMAIN=example.com
TZ=America/Sao_Paulo

# ============================================
# TLS / Certificados
# ============================================
# TLS_ENABLED: controla o entrypoint do Ingress (web vs websecure) e o protocolo do n8n (http vs https).
# Quando false: Ingress usa HTTP (entrypoint web), N8N_PROTOCOL=http
# Quando true:  Ingress usa HTTPS (entrypoint websecure), N8N_PROTOCOL=https
#   dev    -> false (HTTP puro, sem TLS)
#   homolog -> true (cert-manager com Let's Encrypt staging)
#   prod   -> true (cert-manager com Let's Encrypt production)
TLS_ENABLED=false

# ============================================
# PostgreSQL
# ============================================
# Secret: postgres-secret
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
# Bancos de dados criados automaticamente via init script
N8N_DB_NAME=n8n
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=change-me-n8n
SIGNOZ_DB_NAME=signoz
SIGNOZ_DB_USER=signoz_user
SIGNOZ_DB_PASSWORD=change-me-signoz

# ============================================
# Redis
# ============================================
# Secret: redis-secret
REDIS_PASSWORD=change-me-redis

# ============================================
# RabbitMQ
# ============================================
# Secret: rabbitmq-secret
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq
# RABBITMQ_URL varia por ambiente:
#   dev    -> http://rabbitmq.127.0.0.1.nip.io
#   homolog -> http://rabbitmq.homolog.<DOMAIN>
#   prod   -> http://rabbitmq.<DOMAIN>
RABBITMQ_HOST=rabbitmq.all-in-one.svc.cluster.local
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ============================================
# MinIO
# ============================================
# Secret: minio-secret
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_DEFAULT_BUCKET=n8n-storage

# ============================================
# n8n
# ============================================
# Secret: n8n-secret
N8N_ENCRYPTION_KEY=change-me-encryption-key-at-least-32-chars
# N8N_HOST varia por ambiente:
#   dev    -> n8n.127.0.0.1.nip.io
#   homolog -> n8n.homolog.<DOMAIN>
#   prod   -> n8n.<DOMAIN>
N8N_HOST=n8n.example.com
# N8N_PROTOCOL é derivado automaticamente de TLS_ENABLED (não configure manualmente)
N8N_PORT=5678
# Executions mode: "queue" para arquitetura distribuída
N8N_EXECUTIONS_MODE=queue
# Endpoint S3-compatível do MinIO para armazenamento de arquivos
N8N_EXTERNAL_STORAGE_S3_ENDPOINT=http://minio.all-in-one.svc.cluster.local:9000
N8N_EXTERNAL_STORAGE_S3_BUCKET=n8n-storage

# ============================================
# SigNoz
# ============================================
# SIGNOZ_URL varia por ambiente:
#   dev    -> https://signoz.127.0.0.1.nip.io
#   homolog -> https://signoz.homolog.<DOMAIN>
#   prod   -> https://signoz.<DOMAIN>
SIGNOZ_URL=https://signoz.example.com
# Retenção de dados (dias)
SIGNOZ_TRACE_RETENTION_DAYS=7
SIGNOZ_METRICS_RETENTION_DAYS=30

# ============================================
# OpenTelemetry
# ============================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector.all-in-one.svc.cluster.local:4317
OTEL_SERVICE_NAME=n8n

# ============================================
# Minikube / Desenvolvimento Local
# ============================================
# Comando para iniciar o Minikube com recursos adequados:
#   minikube start --cpus=4 --memory=8192 --disk-size=40g
#
# Domínios no Minikube usam nip.io (resolução automática para 127.0.0.1):
#   n8n:      http://n8n.127.0.0.1.nip.io:5678
#   RabbitMQ: http://rabbitmq.127.0.0.1.nip.io:15672
#   MinIO:    http://minio.127.0.0.1.nip.io:9001
#   SigNoz:   http://signoz.127.0.0.1.nip.io:3301
#
# Para acessar serviços no Minikube, use port-forward:
#   make port-forward-n8n         # n8n em http://localhost:5678
#   make port-forward-rabbitmq    # RabbitMQ Management em http://localhost:15672
#   make port-forward-minio       # MinIO Console em http://localhost:9001
#   make port-forward-signoz      # SigNoz em http://localhost:3301
